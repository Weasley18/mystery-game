OPENAI_API_KEY=sk-...
OPENAI_COUNSEL_MODEL=gpt-4o-mini
REDIS_URL=redis://localhost:6379/0
CHECKPOINT_DB=data/checkpoints.db
ACCOUNTS_DB=data/accounts.db
# Required in production — HMAC secret for session tokens
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_SECONDS=2592000
GAME_TTL_SECONDS=86400
QUESTION_COOLDOWN_SECONDS=8
ARGUMENT_COOLDOWN_SECONDS=3
DEBATE_SPEECHES=6
MAX_QUESTIONS_PER_GAME=7
# Unset = localhost defaults. Empty = same-origin only. Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# ENVIRONMENT=production disables /docs and ignores CORS_ORIGINS=*
MAX_PLAYERS_PER_GAME=12
MAX_EXPECTED_PLAYERS=12
IP_CREATE_LIMIT=10
IP_CREATE_WINDOW=60
IP_JOIN_LIMIT=30
IP_JOIN_WINDOW=60
IP_LLM_LIMIT=40
IP_LLM_WINDOW=60
# Azure Speech (TTS preview / NPC audio). Region must match the resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
